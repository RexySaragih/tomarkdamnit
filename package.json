{
  "name": "@rexymayderio/tomarkdamnit",
  "version": "1.2.0",
  "description": "MCP server that converts PDF, DOCX, XLSX/XLS, PPTX, and YouTube videos to Markdown",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "tomarkdamnit": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RexySaragih/tomarkdamnit.git"
  },
  "bugs": {
    "url": "https://github.com/RexySaragih/tomarkdamnit/issues"
  },
  "homepage": "https://github.com/RexySaragih/tomarkdamnit#readme",
  "keywords": [
    "mcp",
    "markdown",
    "converter",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "youtube",
    "model-context-protocol"
  ],
  "engines": {
    "node": "^20.18.1 || >=22.3.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && tsc && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "bun run build",
    "dev": "bun run src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "mammoth": "^1.8.0",
    "pdf-parse": "2.4.5",
    "turndown": "^7.2.0",
    "undici": "7.29.0",
    "xlsjs": "1.0.1",
    "youtube-transcript": "^1.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/turndown": "^5.0.4",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "hono": "4.12.25",
    "@hono/node-server": "2.0.5"
  }
}
